{
  "info": {
    "name": "Sommerce API",
    "description": "Dokumentasi API komprehensif untuk aplikasi E-Commerce Sommerce. \n\nSemua request secara otomatis menggunakan token otentikasi (kecuali Register dan Login). **Pastikan Anda menjalankan endpoint Login terlebih dahulu** agar variabel token terisi otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Ahmad Ammar\",\n  \"email\": \"ahmad@example.com\",\n  \"kata_sandi\": \"rahasia123\",\n  \"notelp\": \"08123456789\",\n  \"tanggal_lahir\": \"2003-06-16\",\n  \"jenis_kelamin\": \"Laki-laki\",\n  \"tentang\": \"Saya suka ngoding\",\n  \"pekerjaan\": \"Backend Engineer\",\n  \"id_provinsi\": \"35\",\n  \"id_kota\": \"35.73\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Mendaftar akun baru. Provinsi dan Kota akan divalidasi ke API Emsifa. Toko kosong akan otomatis terbuat."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200 && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token berhasil di-update!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmad@example.com\",\n  \"kata_sandi\": \"rahasia123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Mendapatkan JWT Token. Setelah sukses, token akan otomatis tersimpan di Variables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. User",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Ahmad Ammar Updated\",\n  \"pekerjaan\": \"Backend Engineer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Toko",
