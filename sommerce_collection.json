              "raw": "{{base_url}}/toko/:id",
              "host": ["{{base_url}}"],
              "path": ["toko", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "masukkan-id-toko"
                }
              ]
            }
          },
          "response": []
        }
