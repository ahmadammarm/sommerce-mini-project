    {
      "name": "7. Transaction",
      "item": [
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Auto-generate UUID to bypass idempotency lock",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method_bayar\": \"BCA Virtual Account\",\n  \"alamat_pengiriman\": \"masukkan-id-alamat\",\n  \"items\": [\n    {\n      \"id_produk\": \"masukkan-id-produk\",\n      \"kuantitas\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/transactions/checkout",
              "host": ["{{base_url}}"],
              "path": ["transactions", "checkout"]
            },
            "description": "Lakukan checkout. X-Idempotency-Key akan otomatis berganti setiap request."
          },
          "response": []
        },
        {
          "name": "Get My Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transactions",
